<Window x:Class="Sway.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sway OSD" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" IsHitTestVisible="False">
  <Border x:Name="Pill" CornerRadius="24" Padding="18,12" Margin="12" BorderThickness="1">

    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
      <Grid Width="180" Height="4" Margin="14,0" VerticalAlignment="Center">
        <Border x:Name="Track" CornerRadius="2" />
        <Border x:Name="Fill" CornerRadius="2" HorizontalAlignment="Left" />
      </Grid>
      <TextBlock x:Name="Percent" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Width="34" TextAlignment="Right" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
