<Window x:Class="Sway.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sway settings" Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6" /></Style>
    <Style TargetType="Slider">
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="20">
    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,12" />
    <CheckBox x:Name="Enabled" Content="Enable edge swipes" />

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="64" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
      </Grid.RowDefinitions>

      <TextBlock Text="Left edge" />
      <ComboBox x:Name="LeftAction" Grid.Column="1" Grid.ColumnSpan="2" />
      <TextBlock Grid.Row="1" Text="Right edge" />
      <ComboBox x:Name="RightAction" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />

      <TextBlock Grid.Row="2" Text="Edge zone width" />
      <Slider x:Name="ZoneWidth" Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="25" TickFrequency="1" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=ZoneWidth, StringFormat={}{0:0} %}" HorizontalAlignment="Right" />

      <TextBlock Grid.Row="3" Text="Activation distance" />
      <Slider x:Name="Activation" Grid.Row="3" Grid.Column="1" Minimum="2" Maximum="10" TickFrequency="0.5" />
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=Activation, StringFormat={}{0:0.0} mm}" HorizontalAlignment="Right" />

      <TextBlock Grid.Row="4" Text="Volume: 0→100 swipe length" />
      <Slider x:Name="VolumeMm" Grid.Row="4" Grid.Column="1" Minimum="25" Maximum="300" TickFrequency="5" />
      <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=VolumeMm, StringFormat={}{0:0} %}" HorizontalAlignment="Right" ToolTip="Percent of the touchpad height. 100 % = a swipe over the full height covers the full range." />

      <TextBlock Grid.Row="5" Text="Brightness: 0→100 swipe length" />
      <Slider x:Name="BrightnessMm" Grid.Row="5" Grid.Column="1" Minimum="25" Maximum="300" TickFrequency="5" />
      <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Value, ElementName=BrightnessMm, StringFormat={}{0:0} %}" HorizontalAlignment="Right" ToolTip="Percent of the touchpad height. 100 % = a swipe over the full height covers the full range." />

      <TextBlock Grid.Row="6" Text="Hide indicator after" />
      <Slider x:Name="OsdTimeout" Grid.Row="6" Grid.Column="1" Minimum="300" Maximum="5000" TickFrequency="100" />
      <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Value, ElementName=OsdTimeout, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" />
    </Grid>

    <CheckBox x:Name="Freeze" Content="Keep the cursor still during an edge swipe" Margin="0,12,0,6" />
    <CheckBox x:Name="Startup" Content="Start Sway when I sign in" />

    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="Defaults" Content="Restore defaults" Padding="12,4" DockPanel.Dock="Left" />
      <Button x:Name="CloseButton" Content="Close" Padding="20,4" DockPanel.Dock="Right" IsCancel="True" IsDefault="True" />
    </DockPanel>
    <TextBlock Margin="0,14,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
               Text="Changes apply immediately. Sway makes no network connections and stores no touch data." />
  </StackPanel>
</Window>
